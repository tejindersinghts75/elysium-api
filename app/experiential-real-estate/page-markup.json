  "markup": "\n  <!-- ══════════════════════════════════════\n       NAV\n  ══════════════════════════════════════ -->\n  <nav id=\"navbar\" class=\"navbar\">\n    <div class=\"nav-inner\">\n      <button class=\"nav-hamburger\" type=\"button\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"mobileMenu\">\n        <span></span><span></span><span></span>\n      </button>\n      <a href=\"https://www.elysiumcommunities.com\" class=\"nav-logo\" aria-label=\"Elysium home\">\n        ELYSIUM\n      </a>\n      <div class=\"nav-links\">\n        <a href=\"https://www.elysiumcommunities.com/location\" class=\"nav-link\">Locations</a>\n        <a href=\"https://www.elysiumcommunities.com/pricing\" class=\"nav-link\">Pricing</a>\n        <a href=\"https://www.elysiumcommunities.com/about-us\" class=\"nav-link\">About Us</a>\n        <a href=\"https://www.elysiumcommunities.com/contact-us\" class=\"nav-link\">Contact Us</a>\n      </div>\n      <a href=\"https://www.elysiumcommunities.com/living-spaces-v2\" class=\"nav-cta\">Enter to Win</a>\n    </div>\n    <div class=\"mobile-menu\" id=\"mobileMenu\" aria-hidden=\"true\">\n      <div class=\"mobile-menu-links\">\n        <a href=\"https://www.elysiumcommunities.com\">Home</a>\n        <a href=\"https://www.elysiumcommunities.com/pricing\">Price</a>\n        <a href=\"https://www.elysiumcommunities.com/blog\">Blogs</a>\n        <a href=\"https://www.elysiumcommunities.com/about-us\">About</a>\n        <a href=\"https://www.elysiumcommunities.com/login\">Login</a>\n        <a href=\"https://www.elysiumcommunities.com/dining\">Dining</a>\n        <a href=\"https://www.elysiumcommunities.com/wellness\">Wellness</a>\n        <a href=\"https://www.elysiumcommunities.com/amenities\">Amenities</a>\n        <a href=\"https://www.elysiumcommunities.com/floorplans\">Floorplans</a>\n        <a href=\"https://www.elysiumcommunities.com/family-life\">Family Life</a>\n        <a href=\"https://www.elysiumcommunities.com/a