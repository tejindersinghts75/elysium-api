"life-fig life-fig--wide\">\n          <img src=\"https://sspark.genspark.ai/cfimages?u1=c9CRXKc1eKAkXuziOmt%2FmKOyolWFjLtaNBk0xAV%2F8dMSQLecY2xwnnph2Ufk6GTMIK5yKNiQ%2BkgZ7iUchihrSPjKb9P%2BfA7z0HtpMeRQD4Ws8BVMK2Hbb7KUE7vceGGYRHLCVXJFclqrzkQNXcii0Lo3OgWlhdWnChycW6Vrf1GfJy0BA6LpoXOVkA%3D%3D&u2=Vly1s1DlkP1wcfDt&width=2560\" alt=\"Community festival\" loading=\"lazy\"/>\n          <figcaption>Seasonal Festivals</figcaption>\n        </figure>\n        <figure class=\"life-fig life-fig--tall\">\n          <img src=\"https://sspark.genspark.ai/cfimages?u1=Ndyi4NRO%2BS%2FYEAfY4vOjc%2Bl1tZib9inl5e6qSWbjnX%2Faa5A4HeLYtJfgPHi7ykXrwP%2BJoay2zSFcsAHW9BKiR2%2B9DdrKW%2BZcI6y5E34MRc%2FhK7vKhIvLF%2BC05MOJPSkejNr%2B%2FkRYr8GtJSBBTyvTln5NVPtxb7lHtRUIT1g6UwA7JL3OdXsxUbP%2BDLRhp8JsCKw9LtOXkJD5xrH87i3SPMOxtvsgQ%2FpbLzx882SmASm4xC1CKK4LwNZ3CiywckyrOqRzlO4%3D&u2=UnuFvrt%2FQelaOKzY&width=2560\" alt=\"Canal waterfront\" loading=\"lazy\"/>\n          <figcaption>Lantern-Lit River</figcaption>\n        </figure>\n        <figure class=\"life-fig life-fig--tall\">\n          <img src=\"https://sspark.genspark.ai/cfimages?u1=vTui8QWsZ8iKQFvVuaKouuc150uzVNyIy0UDnSjKTWdtscfyWMDCQ5S749Kf04%2B2vWckhjALcRPvOk1ktQ3hUnNk%2F35fyP3V36HBQXIqhA3rEnZ0UcynL%2BceaXrX%2FTISWHoGeXHnxo%2FWMhkXghUAOBNdyP0UjMcLEC76bavh0fXe&u2=LQG5sMrxer0hPkgT&width=2560\" alt=\"Farm-to-table community gathering\" loading=\"lazy\"/>\n          <figcaption>Farm &amp; Community Life</figcaption>\n        </figure>\n      </div>\n      <div class=\"gallery-fade-r\"></div>\n    </div>\n  </section>\n\n  <!-- ══════════════════════════════════════\n       MANIFESTO\n  ══════════════════════════════════════ -->\n  <section class=\"manifesto\">\n    <div class=\"manifesto-bg-wrap\">\n      <img src=\"https://sspark.genspark.ai/cfimages?u1=UGHZNgSGZjBlJNtWjbkx%2FjFRfFaSHjiX0kKqXh%2Bw3gmiYq3yzLVhFnjPCbGe1dofp8DG6vP11P7IQkxlqRGs1LE1fdj8mcDnFz2CMCexiDBp4WV1Lop63TQh7eUIUBjkrjaRGBVuNDHXrUpJ%2BwJ%2Fxp5tvzEGAnGPBmXY1HgdnF9q0oSAF1ooZHWdgSdJJrPLOxjX2UAlLhs0mX00PseA%2BWY790bpjVt0XJq9xd%2FKNJS96rj9Tw%3D%3D&u2=c8GrhxV6WXLU4AmQ\" alt=\"Elysium community evening\" class=\"manifesto-bg-img\" loading=\"lazy\"/>\n      <div class=\"manifesto-scrim\"></div>\n    </div>\n    <div class=\"manifesto-inner\" data-animate=\"fade-up\">\n      <blockquote>\n        \"Your environment is your destiny.<br class=\"br-d\" /> We're building one worth living in.\"\n      </blockquote>\n      <cite>— Elysium Communities · Experiential Microcities &amp; Wellness · Est. 2030</cite>\n    </div>\n  </section>\n\n  <!-- ══════════════════════════════════════\n       $499 VALUE PROPOSITION — (replaces \"twelve months rent-free\")\n  ══════════════════════════════════════ -->\n  <section class=\"value-section\">\n    <div class=\"value-card\">\n      <div class=\"value-card-left\" data-animate=\"fade-up\">\n        <p class=\"section-eyebrow dark\">The Junior Suite</p>\n        <h2 class=\"value-h2\">\n          $499 replaces<br />restaurants, car<br />payments, and<br />entertainment.\n        </h2>\n        <p class=\"value-sub\">\n          Elysium is more than a community. It's an experiential ecosystem with on-premise agriculture, fully walkable naturescapes, crowd-sourced activities, and optional quest &amp; volunteering opportunities. You can earn back each month for participating &amp; having fun.\n        </p>\n        <a href=\"#reserve\" class=\"btn-black\">Reserve My Spot for a Junior Suite</a>\n      </div>\n\n      <div class=\"value-card-right\" data-animate=\"scale-in\" data-delay=\"150\">\n        <!-- Bullet specs -->\n        <ul class=\"value-list\">\n          <li>\n            <span class=\"val-check\">✓</span>\n            <div>\n              <strong>Starting at $130,000</strong>\n              <p>Pre-construction pricing — the best time to buy is before it's built.</p>\n            </div>\n          </li>\n          <li>\n            <span class=\"val-check\">✓</span>\n            <div>\n              <strong>400 sqft · Mediterranean Design</strong>\n              <p>Thoughtfully designed for beauty, flow, and intentional living.</p>\n            </div>\n          </li>\n          <li>\n            <span class=\"val-check\">✓</span>\n            <div>\n              <strong>2 Complimentary Meals Daily</strong>\n              <p>Restaurant-quality dining, on-site. Breakfast and dinner included in your monthly fee — every day.</p>\n            </div>\n          </li>\n          <li>\n            <span class=\"val-check\">✓</span>\n            <div>\n              <strong>Shared Community Tesla · 4 hrs/day</strong>\n              <p>Daily access to the community fleet — 4 hours per person per day, with upgrade options available.</p>\n            </div>\n          </li>\n          <li>\n            <span class=\"val-check\">✓</span>\n            <div>\n              <strong>Full Wellness &amp; Nature Access</strong>\n              <p>Sauna, cold plunge, gym, pools, 100+ acres of nature, co-work spaces — all included in your $499 fee.</p>\n            </div>\n          </li>\n          <li>\n            <span class=\"val-check\">✓</span>\n            <div>\n              <strong>Community Quests &amp; Living Credits</strong>\n              <p>Show up, participate, and earn credits back each month. Living here pays you.</p>\n            </div>\n          </li>\n          <li>\n            <span class=\"val-check\">✓</span>\n            <div>\n              <strong>Founding Resident Pricing</strong>\n              <p>Reserve before 2030 and lock in the lowest price this property will ever be.</p>\n            </div>\n          </li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n\n\n  <!-- ══════════════════════════════════════\n       HOW TO RESERVE\n  ══════════════════════════════════════ -->\n  <section class=\"how-section\">\n    <div class=\"how-inner container-pad\">\n      <p class=\"section-eyebrow dark\" data-animate=\"fade-up\">Simple Process</p>\n      <h2 class=\"section-h2 dark\" data-animate=\"fade-up\" data-delay=\"80\">\n        How to reserve your spot<br class=\"br-d\" /> for an Elysium Junior Suite.\n      </h2>\n      <div class=\"how-body\">\n        <div class=\"how-steps\">\n          <div class=\"how-step\" data-animate=\"fade-up\" data-delay=\"0\">\n            <div class=\"step-n\">01</div>\n            <h3>Click Reserve</h3>\n            <p>Click any \"Reserve a Junior Suite\" button on this page to jump to the reservation form below.</p>\n          </div>\n          <div class=\"how-step-arrow\">→</div>\n          <div class=\"how-step\" data-animate=\"fade-up\" data-delay=\"120\">\n            <div class=\"step-n\">02</div>\n            <h3>Complete the Form</h3>\n            <p>Fill in your details. Takes less than two minutes. No payment required at this stage.</p>\n          </div>\n          <div class=\"how-step-arrow\">→</div>\n          <div class=\"how-step\" data-animate=\"fade-up\" data-delay=\"240\">\n            <div class=\"step-n\">03</div>\n            <h3>Your Spot is Held</h3>\n            <p>Hit Reserve and your spot is secured. Our team follows up within 48 hours with next steps.</p>\n          </div>\n        </div>\n        <!-- Floor plan image on the right -->\n        <div class=\"how-floorplan\" data-animate=\"scale-in\" data-delay=\"200\">\n          <div class=\"how-floorplan-frame\">\n            <p class=\"how-floorplan-label\">Junior Suite · 400 sqft</p>\n            <img\n              src=\"https://sspark.genspark.ai/cfimages?u1=o9jgRY5lJo3FiRB1DUUwWsvEB1Xsch%2BM%2Bqj4nQJAbX4TKGbrMPioDbxS%2BPsVFt%2BoJS4U%2FBiwsZe5dUlKZKjaoJGn6gp0XGW9J%2BbFSaVFHXwdEnnI%2FxyWbmq2ZAYrbgvj%2FK6c8J6j5RuqX%2FLK2zmb1UXscVWjZ%2BT9vZwT05A%3D&u2=kcm%2BkDtwQkBaBIp1&width=2560\"\n              alt=\"Elysium Junior Suite floor plan\"\n              class=\"how-floorplan-img\"\n              loading=\"lazy\"\n            />\n            <p class=\"how-floorplan-caption\">Mediterranean Design · Pre-construction pricing from $130,000</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ══════════════════════════════════════\n       FAQ SECTION\n  ══════════════════════════════════════ -->\n  <section class=\"faq-section\">\n    <div class=\"faq-inner container-pad\">\n      <p class=\"section-eyebrow dark\" data-animate=\"fade-up\">Got Questions</p>\n      <h2 class=\"section-h2 dark\" data-animate=\"fade-up\" data-delay=\"80\">Frequently asked.</h2>\n\n      <div class=\"faq-grid\" id=\"faqGrid\">\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"0\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>What exactly is Elysium?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>Elysium is a next-generation residential community — what we call an \"experiential microcity.\" It combines luxury residential living with on-site agriculture, wellness infrastructure, entertainment venues, co-working spaces, and a community-driven economy. Think of it as a small city designed entirely around human well-being, where everything you need is within walking distance and your monthly living costs are dramatically lower than traditional city living.</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"60\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>What is a Junior Suite?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>The Elysium Junior Suite is our flagship entry-level residential unit. Starting at $130,000, it offers 400 square feet of Mediterranean-inspired design — thoughtfully laid out for beauty, flow, and intentional living. Suites are privately owned and come with full access to all Elysium community amenities including agriculture, wellness facilities, eateries, and entertainment. It's the most efficient and affordable way to own property inside an Elysium community.</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"120\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>When will Elysium be ready?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>Elysium is targeting a 2030 completion and opening date. We are currently in the development and pre-sales phase. Reserving now means you lock in founding resident pricing — the lowest price this property will ever be offered at. As construction milestones are reached, pricing will increase. Early reservations also grant priority unit selection.</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"180\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>How does the $499/month work?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>The $499/month community fee is <strong>per person, per month</strong> — and it replaces far more than most people realize. Included in your fee: <strong>2 full meals per day</strong> (breakfast and dinner) at on-site restaurants, <strong>4 hours of community Tesla access daily</strong> (upgradeable for power users), and full access to all amenities — sauna, cold plunge, gym, pools, biophilic fitness spaces, <strong>100+ acres of nature trails and landscapes</strong>, co-working facilities, entertainment venues, seasonal festivals, and community programming. Through Elysium's living credits program, you can also earn credits back each month for participating in community activities and quests — further reducing your effective cost.</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"0\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>What are Living Credits?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>Living Credits are Elysium's community reward currency. Residents earn credits by participating in community quests, volunteering for community initiatives, attending events, and contributing to collective community projects. These credits can be redeemed against your monthly community fee, at on-site eateries, at the wellness center, and at participating community businesses. It's our way of rewarding people for showing up, being present, and having fun — living here pays you back.</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"60\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>What does reserving mean — is there a deposit?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>Reserving through this form places you on the priority waitlist at the current published price. After submitting your reservation form, our team will contact you within 48 hours to walk you through the next steps, including any deposit requirements to fully secure your unit. There is no charge or commitment required to complete the reservation form itself — it simply holds your place in the queue at today's pricing.</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"120\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>Where is Elysium located?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>Elysium's first community is planned for <strong>Austin, Texas</strong>, targeting a <strong>2030</strong> opening. We are actively exploring multiple additional cities for future communities. For full location details and a live map of where we're building, visit our dedicated <a href=\"https://www.elysiumcommunities.com/locations\" class=\"faq-link\">Locations page</a> — linked at the top of this page. Reserving now secures your spot at founding pricing regardless of which city you choose.</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"180\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>Can I own my Junior Suite outright?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>Yes. The Elysium Junior Suite is a purchasable residential unit — you own the property. The $499/month community fee covers access to all shared infrastructure, amenities, and services. This is similar to an HOA structure, but with significantly more included and a community-driven economy that allows you to earn credits back. Financing options and full ownership terms will be discussed with our team once you're on the waitlist.</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"0\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>What's included in the community amenities?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>Elysium is designed as a complete lifestyle ecosystem. Residents have access to: on-site organic farm and market, multiple daily eateries and food concepts, biophilic fitness and wellness facilities (sauna, cold plunge, gym, pools), co-working spaces, community gathering spaces, entertainment venues including midnight theatres, a shared community Tesla fleet (4 hours/day per resident), 2 complimentary meals daily, seasonal festivals and programming, and participation in the community quest and volunteering system. The surrounding natural landscape gives you a hundred acres of reasons to explore.</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\" data-animate=\"fade-up\" data-delay=\"60\">\n          <button class=\"faq-q\" aria-expanded=\"false\">\n            <span>How is this different from a regular apartment or condo?</span>\n            <span class=\"faq-icon\">+</span>\n          </button>\n          <div class=\"faq-a\" hidden>\n            <p>Traditional apartments give you four walls. Elysium gives you an entire ecosystem. The difference is in what surrounds you — an on-site farm, community restaurants, entertainment, wellness, nature, and a curated group of people who choose to live intentionally. The unit price ($130,000+) is significantly lower than comparable quality real estate in most markets, because Elysium's construction model, shared infrastructure, and community-driven economy allow us to pass those savings to owners. You're not just buying a home — you're buying into a way of life.</p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- ══════════════════════════════════════\n       RESERVE FORM\n  ══════════════════════════════════════ -->\n  <section id=\"reserve\" class=\"form-section\">\n    <div class=\"form-section-inner container-pad\">\n      <!-- Left: Pitch -->\n      <div class=\"form-pitch\" data-animate=\"fade-up\">\n        <p class=\"section-eyebrow\">Reserve Now</p>\n        <h2 class=\"form-pitch-h2\">\n          Get on the<br />waitlist before<br />they're gone.\n        </h2>\n        <p class=\"form-pitch-body\">\n          Reserve your spot for an Elysium Junior Suite. Starting at $130,000, 400 sqft of Mediterranean-inspired design inside of a community built for human connection. Get on the waitlist before they're gone.\n        </p>\n        <div class=\"form-trust-list\">\n          <div class=\"trust-row\"><span class=\"trust-check\">✓</span> No payment required to reserve</div>\n          <div class=\"trust-row\"><span class=\"trust-check\">✓</span> Lock in today's founding price</div>\n          <div class=\"trust-row\"><span class=\"trust-check\">✓</span> Priority unit selection for early reservations</div>\n          <div class=\"trust-row\"><span class=\"trust-check\">✓</span> Our team follows up within 48 hours</div>\n        </div>\n      </div>\n\n      <!-- Right: Form card -->\n      <div class=\"form-card\" data-animate=\"scale-in\" data-delay=\"150\">\n        <div class=\"form-card-header\">\n          <p class=\"form-card-eyebrow\">The Elysium Junior Suite</p>\n          <p class=\"form-card-price\">From <strong>$130,000</strong> · 400 sqft</p>\n        </div>\n        <form id=\"reserveForm\" novalidate>\n          <div class=\"fg-row\">\n            <div class=\"fg\">\n              <label for=\"firstName\">First Name</label>\n              <input type=\"text\" id=\"firstName\" name=\"firstName\" placeholder=\"First name\" required autocomplete=\"given-name\" />\n            </div>\n            <div class=\"fg\">\n              <label for=\"lastName\">Last Name</label>\n              <input type=\"text\" id=\"lastName\" name=\"lastName\" placeholder=\"Last name\" required autocomplete=\"family-name\" />\n            </div>\n          </div>\n          <div class=\"fg\">\n            <label for=\"email\">Email Address</label>\n            <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"you@example.com\" required autocomplete=\"email\" />\n          </div>\n          <div class=\"fg\">\n            <label for=\"phone\">Phone Number <span class=\"fg-opt\">(optional)</span></label>\n            <input type=\"tel\" id=\"phone\" name=\"phone\" placeholder=\"+1 (000) 000-0000\" autocomplete=\"tel\" />\n          </div>\n          <div class=\"fg\">\n            <label for=\"timeline\">When are you looking to move? <span class=\"fg-opt\">(optional)</span></label>\n            <select id=\"timeline\" name=\"timeline\">\n              <option value=\"\" disabled selected>Select a timeframe</option>\n              <option value=\"asap\">As soon as possible (2030 opening)</option>\n              <option value=\"2030\">Around 2030</option>\n              <option value=\"flexible\">Flexible / Just exploring</option>\n            </select>\n          </div>\n          <div class=\"fg\">\n            <label for=\"why\">What draws you to Elysium? <span class=\"fg-opt\">(optional)</span></label>\n            <textarea id=\"why\" name=\"why\" rows=\"3\" placeholder=\"I'm drawn to the idea of a community designed around how I actually want to live…\"></textarea>\n          </div>\n          <div class=\"fg fg-check\">\n            <label class=\"check-label\">\n              <input type=\"checkbox\" id=\"consent\" name=\"consent\" required />\n              <span class=\"check-box\"></span>\n              <span class=\"check-text\">I agree to Elysium's <a href=\"https://www.elysiumcommunities.com/privacy-policy\" target=\"_blank\" rel=\"noopener\" class=\"form-a\">Privacy Policy</a> and <a href=\"https://www.elysiumcommunities.com/terms-of-use\" target=\"_blank\" rel=\"noopener\" class=\"form-a\">Terms of Use</a>. I understand I may receive updates from Elysium Communities and can unsubscribe at any time.</span>\n            </label>\n          </div>\n          <button type=\"submit\" class=\"btn-submit\" id=\"submitBtn\">\n            <span class=\"btn-txt\">Reserve a Junior Suite</span>\n            <span class=\"btn-arr\">→</span>\n          </button>\n        </form>\n\n        <!-- Success state -->\n        <div id=\"successMsg\" class=\"success-state\" style=\"display:none;\">\n          <div class=\"success-icon\">✦</div>\n          <h3>You're on the list.</h3>\n          <p>Your reservation request has been received. Our team will contact you within 48 hours to walk you through next steps.</p>\n          <div class=\"share-block\">\n            <p class=\"share-label\">Know someone who'd love Elysium?</p>\n            <div class=\"share-btns\">\n              <a href=\"https://twitter.com/intent/tweet?text=I+just+reserved+my+spot+for+an+%40ElysiumOnX+Junior+Suite.+Starting+at+%24130%2C000+for+a+community+built+for+human+connection.+%F0%9F%8C%BF+elysiumcommunities.com\" target=\"_blank\" rel=\"noopener\" class=\"share-x\">Share on X</a>\n              <a href=\"https://www.instagram.com/elysiumcommunities\" target=\"_blank\" rel=\"noopener\" class=\"share-ig\">Follow on Instagram</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ══════════════════════════════════════\n       FINAL CTA — DARK\n  ══════════════════════════════════════ -->\n  <section class=\"final-cta\">\n    <div class=\"final-cta-inner container-pad\" data-animate=\"fade-up\">\n      <p class=\"section-eyebrow light\">Coming 2030</p>\n      <h2 class=\"final-h2\">This is the door.<br />Are you walking through?</h2>\n      <p class=\"final-sub\">Pricing increases as construction milestones are reached. The best time to reserve is now.</p>\n      <a href=\"#reserve\" class=\"btn-white\">Reserve a Junior Suite</a>\n    </div>\n  </section>\n\n  <!-- ══════════════════════════════════════\n       FOOTER\n  ══════════════════════════════════════ -->\n  <footer class=\"footer\">\n    <div class=\"footer-inner container-pad\">\n      <div class=\"footer-top\">\n        <div class=\"footer-brand\">\n          <span class=\"footer-logo\">ELYSIUM</span>\n          <span class=\"footer-tagline\">Experiential Microcities &amp; Wellness</span>\n        </div>\n        <nav class=\"footer-nav\">\n          <a href=\"https://www.elysiumcommunities.com\" class=\"footer-link\">Communities</a>\n          <a href=\"https://www.elysiumcommunities.com/floorplans\" class=\"footer-link\">Floorplans</a>\n          <a href=\"https://www.elysiumcommunities.com/contact-us\" class=\"footer-link\">Contact</a>\n          <a href=\"https://x.com/ElysiumOnX\" target=\"_blank\" rel=\"noopener\" class=\"footer-link\">@ElysiumOnX</a>\n          <a href=\"https://www.elysiumcommunities.com/privacy-policy\" target=\"_blank\" rel=\"noopener\" class=\"footer-link\">Privacy Policy</a>\n          <a href=\"https://www.elysiumcommunities.com/terms-of-use\" target=\"_blank\" rel=\"noopener\" class=\"footer-link\">Terms of Use</a>\n        </nav>\n      </div>\n      <div class=\"footer-legal\">\n        <p>All pricing, specifications, renderings, and timelines are subject to change without notice and do not constitute a binding offer or contract. The Elysium Junior Suite starting price of $130,000 reflects pre-construction pricing as of current publication and may increase as development milestones are achieved. Reservation of a unit through this form does not constitute a purchase agreement. Full purchase terms, financing options, and legal documentation will be provided upon qualification and execution of a formal purchase agreement. Elysium Communities reserves the right to modify, delay, or cancel any development at any time. For full terms, visit <a href=\"https://www.elysiumcommunities.com/terms-of-use\" target=\"_blank\" rel=\"noopener\" class=\"footer-link-inline\">elysiumcommunities.com/terms-of-use</a>. For our privacy practices, visit <a href=\"https://www.elysiumcommunities.com/privacy-policy\" target=\"_blank\" rel=\"noopener\" class=\"footer-link-inline\">elysiumcommunities.com/privacy-policy</a>.</p>\n      </div>\n      <div class=\"footer-copy\">\n        © 2025 Elysium Communities. All rights reserved. Building the world we actually want to live in.\n      </div>\n    </div>\n  </footer>\n\n"
